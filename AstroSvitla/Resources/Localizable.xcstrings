        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks kopīgoti 5 attēli. Izveidojiet karuseļa ierakstu Instagram."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ചിത്രങ്ങൾ പങ്കിടും. Instagram-ൽ കറൗസൽ പോസ്റ്റ് സൃഷ്ടിക്കുക."
