        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 слика ће бити подељено. Направите каросел објаву на Instagram-у."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "5 bilder kommer att delas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Picha 5 zitashirikiwa. Unda chapisho la karuseli kwenye Instagram."
