    "onboarding.page1.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشف ما تقوله النجوم عن مهنتك وعلاقاتك وأموالك — بدون تسجيل، بدون اشتراكات."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Открий какво казват звездите за кариерата, взаимоотношенията и финансите ти — без регистрация, без абонаменти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্যারিয়ার, সম্পর্ক এবং অর্থ সম্পর্কে তারারা কী বলে তা জানুন — কোনো নিবন্ধন নেই, কোনো সাবস্ক্রিপশন নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjistěte, co hvězdy říkají o vaší kariéře, vztazích a financích — bez registrace, bez předplatného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdag hvad stjernerne siger om din karriere, forhold og økonomi — ingen registrering, ingen abonnementer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken Sie, was die Sterne über Ihre Karriere, Beziehungen und Finanzen sagen — keine Registrierung, keine Abonnements."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανακαλύψτε τι λένε τα άστρα για την καριέρα, τις σχέσεις και τα οικονομικά σας — χωρίς εγγραφή, χωρίς συνδρομές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover what the stars say about your career, relationships, and finances — no registration, no subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre lo que dicen las estrellas sobre tu carrera, relaciones y finanzas — sin registro, sin suscripciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avasta, mida tähed ütlevad sinu karjääri, suhete ja rahanduse kohta — ilma registreerimiseta, ilma tellimuseta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کشف کنید ستارگان درباره شغل، روابط و مالی شما چه می‌گویند — بدون ثبت‌نام، بدون اشتراک."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä mitä tähdet kertovat urastasi, ihmissuhteistasi ja taloudestasi — ilman rekisteröitymistä, ilman tilauksia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuklasin kung ano ang sinasabi ng mga bituin tungkol sa iyong karera, mga relasyon, at pananalapi — walang pagpaparehistro, walang subscription."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez ce que les étoiles disent de votre carrière, vos relations et vos finances — sans inscription, sans abonnement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શોધો કે તારાઓ તમારી કારકિર્દી, સંબંધો અને નાણાં વિશે શું કહે છે — કોઈ નોંધણી નહીં, કોઈ સબ્સ્ક્રિપ્શન નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גלה מה הכוכבים אומרים על הקריירה, מערכות היחסים והכספים שלך — ללא הרשמה, ללא מנויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानें कि सितारे आपके करियर, रिश्तों और वित्त के बारे में क्या कहते हैं — बिना पंजीकरण, बिना सदस्यता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otkrij što zvijezde govore o tvojoj karijeri, odnosima i financijama — bez registracije, bez pretplate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fedezd fel, mit mondanak a csillagok a karrieredről, kapcsolataidról és pénzügyeidről — regisztráció és előfizetés nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan apa yang dikatakan bintang tentang karier, hubungan, dan keuangan Anda — tanpa pendaftaran, tanpa langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri cosa dicono le stelle sulla tua carriera, relazioni e finanze — senza registrazione, senza abbonamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリア、人間関係、財務について星が何を語るか発見しましょう — 登録不要、サブスク不要。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವೃತ್ತಿ, ಸಂಬಂಧಗಳು ಮತ್ತು ಹಣಕಾಸಿನ ಬಗ್ಗೆ ನಕ್ಷತ್ರಗಳು ಏನು ಹೇಳುತ್ತವೆ ಎಂದು ಕಂಡುಹಿಡಿಯಿರಿ — ನೋಂದಣಿ ಇಲ್ಲ, ಚಂದಾದಾರಿಕೆ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별이 당신의 경력, 관계, 재정에 대해 말하는 것을 알아보세요 — 가입 불필요, 구독 불필요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sužinokite, ką žvaigždės sako apie jūsų karjerą, santykius ir finansus — be registracijos, be prenumeratų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzziniet, ko zvaigznes stāsta par jūsu karjeru, attiecībām un finansēm — bez reģistrācijas, bez abonementiem."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കരിയർ, ബന്ധങ്ങൾ, സാമ്പത്തികം എന്നിവയെക്കുറിച്ച് നക്ഷത്രങ്ങൾ എന്താണ് പറയുന്നതെന്ന് കണ്ടെത്തുക — രജിസ്ട്രേഷനില്ല, സബ്സ്ക്രിപ്ഷനുകളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे करिअर, नातेसंबंध आणि आर्थिक बद्दल तारे काय सांगतात ते शोधा — नोंदणी नाही, सदस्यता नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Temui apa yang bintang katakan tentang kerjaya, hubungan dan kewangan anda — tanpa pendaftaran, tanpa langganan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdag hva stjernene sier om din karriere, relasjoner og økonomi — ingen registrering, ingen abonnementer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek wat de sterren zeggen over je carrière, relaties en financiën — geen registratie, geen abonnementen."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਣੋ ਕਿ ਤਾਰੇ ਤੁਹਾਡੇ ਕਰੀਅਰ, ਰਿਸ਼ਤਿਆਂ ਅਤੇ ਵਿੱਤ ਬਾਰੇ ਕੀ ਕਹਿੰਦੇ ਹਨ — ਕੋਈ ਰਜਿਸਟ੍ਰੇਸ਼ਨ ਨਹੀਂ, ਕੋਈ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkryj, co mówią gwiazdy o Twojej karierze, związkach i finansach — bez rejestracji, bez subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubra o que as estrelas dizem sobre sua carreira, relacionamentos e finanças — sem cadastro, sem assinaturas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descoperă ce spun stelele despre cariera, relațiile și finanțele tale — fără înregistrare, fără abonamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, что говорят звёзды о вашей карьере, отношениях и финансах — без регистрации, без подписок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Objavte, čo hovoria hviezdy o vašej kariére, vzťahoch a financiách — bez registrácie, bez predplatného."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkrij, kaj zvezde pravijo o tvoji karieri, odnosih in financah — brez registracije, brez naročnine."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Откријте шта звезде кажу о вашој каријери, односима и финансијама — без регистрације, без претплата."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upptäck vad stjärnorna säger om din karriär, relationer och ekonomi — ingen registrering, inga prenumerationer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gundua nyota zinasema nini kuhusu kazi yako, mahusiano na fedha — bila usajili, bila usajili."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தொழில், உறவுகள் மற்றும் நிதி பற்றி நட்சத்திரங்கள் என்ன சொல்கின்றன என்பதைக் கண்டறியுங்கள் — பதிவு இல்லை, சந்தா இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వృత్తి, సంబంధాలు మరియు ఆర్థిక విషయాల గురించి నక్షత్రాలు ఏమి చెబుతున్నాయో తెలుసుకోండి — నమోదు లేదు, చందాలు లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นพบสิ่งที่ดวงดาวบอกเกี่ยวกับอาชีพ ความสัมพันธ์ และการเงินของคุณ — ไม่ต้องลงทะเบียน ไม่ต้องสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıldızların kariyeriniz, ilişkileriniz ve mali durumunuz hakkında ne söylediğini öğrenin — kayıt yok, abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтесь, що зірки кажуть про вашу кар'єру, стосунки та фінанси — без реєстрації, без підписок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دریافت کریں کہ ستارے آپ کے کیریئر، تعلقات اور مالیات کے بارے میں کیا کہتے ہیں — بغیر رجسٹریشن، بغیر سبسکرپشن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá những gì các vì sao nói về sự nghiệp, mối quan hệ và tài chính của bạn — không cần đăng ký, không cần đăng ký gói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解星星对您的事业、关系和财务的启示——无需注册，无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "了解星星對您的事業、關係和財務的啟示——無需註冊，無需訂閱。"
          }
        }
      }
    },
