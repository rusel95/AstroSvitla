    "onboarding.page2.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جعلنا العملية سريعة وبسيطة قدر الإمكان."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направихме процеса възможно най-бърз и прост."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা প্রক্রিয়াটি যতটা সম্ভব দ্রুত এবং সহজ করেছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proces jsme udělali co nejrychlejší a nejjednodušší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har gjort processen så hurtig og enkel som muligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben den Prozess so schnell und einfach wie möglich gemacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάναμε τη διαδικασία όσο πιο γρήγορη και απλή γίνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We made the process as quick and simple as possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicimos el proceso lo más rápido y simple posible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegime protsessi võimalikult kiireks ja lihtsaks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ما فرآیند را تا حد امکان سریع و آسان کردیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teimme prosessista mahdollisimman nopean ja yksinkertaisen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginawa naming mabilis at simple ang proseso hangga't maaari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons rendu le processus aussi rapide et simple que possible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે પ્રક્રિયાને શક્ય તેટલી ઝડપી અને સરળ બનાવી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפכנו את התהליך למהיר וקל ככל האפשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने प्रक्रिया को जितना संभव हो उतना तेज़ और सरल बनाया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proces smo učinili što bržim i jednostavnijim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folyamatot a lehető leggyorsabbá és legegyszerűbbé tettük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami membuat prosesnya secepat dan sesederhana mungkin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo reso il processo il più veloce e semplice possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスをできるだけ迅速かつシンプルにしました。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾವು ಪ್ರಕ್ರಿಯೆಯನ್ನು ಸಾಧ್ಯವಾದಷ್ಟು ವೇಗವಾಗಿ ಮತ್ತು ಸುಲಭವಾಗಿಸಿದ್ದೇವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스를 최대한 빠르고 간단하게 만들었습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padarėme procesą kuo greitesnį ir paprastesnį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēs padarījām procesu pēc iespējas ātrāku un vienkāršāku."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രക്രിയ കഴിയുന്നത്ര വേഗത്തിലും എളുപ്പത്തിലും ആക്കി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही प्रक्रिया शक्य तितकी जलद आणि सोपी केली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menjadikan proses secepat dan semudah mungkin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi gjorde prosessen så rask og enkel som mulig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We maakten het proces zo snel en eenvoudig mogelijk."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸੀਂ ਪ੍ਰਕਿਰਿਆ ਨੂੰ ਜਿੰਨਾ ਸੰਭਵ ਹੋ ਸਕੇ ਤੇਜ਼ ਅਤੇ ਆਸਾਨ ਬਣਾਇਆ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczyniliśmy proces tak szybkim i prostym, jak to możliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornamos o processo o mais rápido e simples possível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am făcut procesul cât mai rapid și simplu posibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы сделали процесс максимально быстрым и простым."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Urobili sme proces čo najrýchlejší a najjednoduchší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proces smo naredili čim hitrejši in preprostejši."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Учинили смо процес што бржим и једноставнијим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi gjorde processen så snabb och enkel som möjligt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumefanya mchakato kuwa haraka na rahisi iwezekanavyo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்முறையை முடிந்தவரை வேகமாகவும் எளிதாகவும் ஆக்கினோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రక్రియను సాధ్యమైనంత వేగంగా మరియు సులభంగా చేసాము."
