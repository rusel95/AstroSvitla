        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu andmed jäävad ainult sinu seadmesse. Alusta kohe — esimene profiil on tasuta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های شما فقط در دستگاه شما می‌ماند. همین الان شروع کنید — اولین پروفایل رایگان است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietosi pysyvät vain laitteellasi. Aloita nyt — ensimmäinen profiili on ilmainen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong data ay nananatili lamang sa iyong device. Magsimula na — libreng unang profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent uniquement sur votre appareil. Commencez maintenant — le premier profil est gratuit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ડેટા માત્ર તમારા ઉપકરણ પર રહે છે. હવે શરૂ કરો — પ્રથમ પ્રોફાઇલ મફત છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים שלך נשארים רק במכשיר שלך. התחל עכשיו — פרופיל ראשון בחינם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा केवल आपके डिवाइस पर रहता है। अभी शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podaci ostaju samo na tvom uređaju. Započni sada — prvi profil je besplatan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adataid csak az eszközödön maradnak. Kezdd most — az első profil ingyenes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda hanya tersimpan di perangkat Anda. Mulai sekarang — profil pertama gratis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati rimangono solo sul tuo dispositivo. Inizia ora — il primo profilo è gratuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはあなたのデバイスにのみ保存されます。今すぐ始めましょう — 最初のプロフィールは無料です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡೇಟಾ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಮಾತ್ರ ಉಳಿಯುತ್ತದೆ. ಈಗ ಪ್ರಾರಂಭಿಸಿ — ಮೊದಲ ಪ್ರೊಫೈಲ್ ಉಚಿತ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 귀하의 기기에만 저장됩니다. 지금 시작하세요 — 첫 번째 프로필은 무료입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų duomenys lieka tik jūsų įrenginyje. Pradėkite dabar — pirmasis profilis nemokamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu dati paliek tikai jūsu ierīcē. Sāciet tagad — pirmais profils ir bezmaksas."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഡാറ്റ നിങ്ങളുടെ ഉപകരണത്തിൽ മാത്രം നിലനിൽക്കുന്നു. ഇപ്പോൾ ആരംഭിക്കുക — ആദ്യ പ്രൊഫൈൽ സൗജന്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा डेटा फक्त तुमच्या डिव्हाइसवर राहतो. आता सुरू करा — पहिला प्रोफाइल मोफत आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data anda kekal hanya pada peranti anda. Mula sekarang — profil pertama percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene dine forblir bare på enheten din. Start nå — første profil er gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens blijven alleen op je apparaat. Start nu."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਡਾਟਾ ਸਿਰਫ਼ ਤੁਹਾਡੀ ਡਿਵਾਈਸ 'ਤੇ ਰਹਿੰਦਾ ਹੈ। ਹੁਣੇ ਸ਼ੁਰੂ ਕਰੋ — ਪਹਿਲਾ ਪ੍ਰੋਫਾਈਲ ਮੁਫ਼ਤ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane zostają tylko na Twoim urządzeniu. Zacznij teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam apenas no seu dispositivo. Comece agora — o primeiro perfil é gratuito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale rămân doar pe dispozitivul tău. Începe acum — primul profil este gratuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные хранятся только на вашем устройстве. Начните прямо сейчас — первый профиль бесплатный."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje zostávajú len na vašom zariadení. Začnite teraz — prvý profil je zadarmo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podatki ostanejo le na tvoji napravi. Začni zdaj — prvi profil je brezplačen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши подаци остају само на вашем уређају. Почните сада — први профил је бесплатан."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina data stannar bara på din enhet. Börja nu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yako inabaki tu kwenye kifaa chako. Anza sasa — wasifu wa kwanza ni bure."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தரவு உங்கள் சாதனத்தில் மட்டுமே இருக்கும். இப்போதே தொடங்குங்கள் — முதல் சுயவிவரம் இலவசம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డేటా మీ పరికరంలో మాత్రమే ఉంటుంది. ఇప్పుడే ప్రారంభించండి — మొదటి ప్రొఫైల్ ఉచితం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลของคุณอยู่ในอุปกรณ์ของคุณเท่านั้น เริ่มเลย — โปรไฟล์แรกฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz yalnızca cihazınızda kalır. Şimdi başlayın — ilk profil ücretsiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дані зберігаються лише на вашому пристрої. Почніть прямо зараз — перший профіль безкоштовний."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا صرف آپ کے ڈیوائس پر رہتا ہے۔ ابھی شروع کریں — پہلا پروفائل مفت ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của bạn chỉ ở trên thiết bị của bạn. Bắt đầu ngay — hồ sơ đầu tiên miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的数据仅保存在您的设备上。现在开始——首个配置文件免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的資料僅保存在您的裝置上。現在開始吧。"
          }
        }
      }
    },
