    "purchase.error.duplicate.recovery": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your credit should already be available. Check your credit balance."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্রেডিট ইতিমধ্যে উপলব্ধ থাকা উচিত। আপনার ক্রেডিট ব্যালেন্স দেখুন।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредитът ти вече трябва да е наличен. Провери баланса на кредитите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kredit by již měl být dostupný. Zkontrolujte svůj zůstatek kreditů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din kredit burde allerede være tilgængelig. Tjek din kreditsaldo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je credit zou al beschikbaar moeten zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój kredyt powinien być już dostępny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πίστωσή σας θα πρέπει να είναι ήδη διαθέσιμη."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका क्रेडिट अब उपलब्ध होना चाहिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون رصيدك متاحاً الآن."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din kredit bör redan vara tillgänglig."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的點數應已可用。"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kredited már elérhetőnek kell lennie. Ellenőrizd a kredit egyenleged."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat available na ang iyong kredito. Tingnan ang iyong balanse ng kredito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creditul tău ar trebui să fie deja disponibil. Verifică soldul creditelor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tín dụng của bạn đã có sẵn. Kiểm tra số dư tín dụng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit Anda seharusnya sudah tersedia. Periksa saldo kredit Anda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครดิตของคุณควรพร้อมใช้งานแล้ว ตรวจสอบยอดเครดิตของคุณ"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediittisi pitäisi olla jo käytettävissä. Tarkista krediittisaldosi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš kredit by mal byť už dostupný. Skontrolujte zostatok kreditov."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu krediit peaks juba saadaval olema. Kontrolli krediidijääki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditten din bør allerede være tilgjengelig. Sjekk kredittsaldoen din."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj kredit bi moral biti že na voljo. Preveri stanje kreditov."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit anda sepatutnya sudah tersedia. Semak baki kredit anda."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj kredit bi već trebao biti dostupan. Provjeri stanje kredita."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची क्रेडिट आधीच उपलब्ध असावी. तुमची क्रेडिट बॅलन्स तपासा."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų kreditas turėtų būti jau pasiekiamas. Patikrinkite savo kreditų likutį."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கிரெடிட் ஏற்கனவே கிடைக்க வேண்டும். உங்கள் கிரெடிட் இருப்பைச் சரிபார்க்கவும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا کریڈٹ پہلے سے دستیاب ہونا چاہیے۔ اپنا کریڈٹ بیلنس چیک کریں۔"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ക്രെഡിറ്റ് ഇതിനകം ലഭ്യമായിരിക്കണം. നിങ്ങളുടെ ക്രെഡിറ്റ് ബാലൻസ് പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਕ੍ਰੈਡਿਟ ਪਹਿਲਾਂ ਹੀ ਉਪਲਬਧ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ। ਆਪਣਾ ਕ੍ਰੈਡਿਟ ਬੈਲੇਂਸ ਚੈੱਕ ਕਰੋ।"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш кредит би требало да је већ доступан. Проверите стање кредита."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ಈಗಾಗಲೇ ಲಭ್ಯವಾಗಿರಬೇಕು. ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ಬ್ಯಾಲೆನ್ಸ್ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ક્રેડિટ પહેલેથી ઉપલબ્ધ હોવી જોઈએ. તમારી ક્રેડિટ બેલેન્સ તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקרדיט שלך אמור להיות כבר זמין. בדוק את יתרת הקרדיטים שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتبار شما باید از قبل موجود باشد. موجودی اعتبار خود را بررسی کنید."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ క్రెడిట్ ఇప్పటికే అందుబాటులో ఉండాలి. మీ క్రెడిట్ బ్యాలెన్స్ తనిఖీ చేయండి."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu kredītam jau vajadzētu būt pieejamam. Pārbaudiet kredītu atlikumu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mkopo wako tayari unapaswa kupatikana. Angalia salio la mkopo wako."
          }
        }
      }
    },
