        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডেটা শুধুমাত্র আপনার ডিভাইসে থাকে। এখনই শুরু করুন — প্রথম প্রোফাইল বিনামূল্যে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data zůstávají pouze na vašem zařízení. Začněte nyní — první profil je zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data forbliver kun på din enhed. Start nu — første profil er gratis."
