    "birth.help.precision": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل تفاصيل الميلاد بدقة. الوقت الدقيق يضمن حساب البيوت بشكل صحيح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведи точни данни за раждане. Точният час осигурява правилно изчисляване на домовете."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক জন্ম তথ্য দিন। সঠিক সময় গৃহ গণনা নিশ্চিত করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte přesné údaje o narození. Přesný čas zajistí správný výpočet domů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast nøjagtige fødselsoplysninger. Præcis tid sikrer korrekt husberegning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für beste Ergebnisse geben Sie die genaue Geburtszeit ein"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισάγετε ακριβή στοιχεία γέννησης. Η ακριβής ώρα εξασφαλίζει σωστό υπολογισμό οίκων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter exact birth details. Precise time ensures accurate house calculation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mejores resultados, ingresa la hora exacta de nacimiento"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta täpsed sünniandmed. Täpne aeg tagab õige majade arvutuse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جزئیات دقیق تولد را وارد کنید. زمان دقیق محاسبات خانه صحیح را تضمین می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä tarkat syntymätiedot. Tarkka aika varmistaa oikean huonelaskelman."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang eksaktong detalye ng kapanganakan. Ang tumpak na oras ay nagtitiyak ng wastong kalkulasyon ng bahay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour de meilleurs résultats, entrez l'heure exacte de naissance"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચોક્કસ જન્મ વિગતો દાખલ કરો. સચોટ સમય યોગ્ય ગૃહ ગણતરી સુનિશ્ચિત કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן פרטי לידה מדויקים. שעה מדויקת מבטיחה חישובי בתים נכונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक जन्म विवरण दर्ज करें। सटीक समय भाव गणना सुनिश्चित करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesi točne podatke o rođenju. Točno vrijeme osigurava ispravan izračun kuća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add meg a pontos születési adatokat. A pontos idő biztosítja a házak helyes számítását."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan detail kelahiran yang tepat. Waktu yang akurat memastikan perhitungan rumah yang benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per risultati migliori, inserisci l'ora esatta di nascita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最良の結果を得るには、正確な出生時刻を入力してください"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಖರ ಜನ್ಮ ವಿವರಗಳನ್ನು ನಮೂದಿಸಿ. ನಿಖರ ಸಮಯ ಸರಿಯಾದ ಮನೆ ಲೆಕ್ಕಾಚಾರಗಳನ್ನು ಖಚಿತಪಡಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최상의 결과를 위해 정확한 출생 시간을 입력하세요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite tikslius gimimo duomenis. Tikslus laikas užtikrina teisingus namų skaičiavimus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet precīzus dzimšanas datus. Precīzs laiks nodrošina pareizus māju aprēķinus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൃത്യമായ ജനന വിശദാംശങ്ങൾ നൽകുക. കൃത്യമായ സമയം ശരിയായ ഭവന കണക്കുകൂട്ടലുകൾ ഉറപ്പാക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अचूक जन्म तपशील प्रविष्ट करा. अचूक वेळ योग्य घर गणना सुनिश्चित करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan butiran kelahiran yang tepat. Masa yang tepat memastikan pengiraan rumah yang betul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi nøyaktige fødselsdetaljer. Presis tid sikrer korrekt husberegning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer exacte geboortegegevens in. Precieze tijd zorgt voor nauwkeurige huizenberekening."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਹੀ ਜਨਮ ਵੇਰਵੇ ਦਰਜ ਕਰੋ। ਸਹੀ ਸਮਾਂ ਸਹੀ ਘਰ ਗਣਨਾ ਨੂੰ ਯਕੀਨੀ ਬਣਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź dokładne dane urodzenia. Precyzyjny czas zapewnia poprawne obliczenie domów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para melhores resultados, insira a hora exata de nascimento"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu detaliile exacte ale nașterii. Ora precisă asigură calculul corect al caselor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для лучших результатов введите точное время рождения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte presné údaje o narodení. Presný čas zabezpečuje správny výpočet domov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesi natančne podatke o rojstvu. Natančen čas zagotavlja pravilno izračunavanje hiš."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Унесите тачне податке о рођењу. Тачно време осигурава исправан прорачун кућа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange exakta födelseuppgifter. Exakt tid säkerställer korrekt husberäkning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingiza maelezo sahihi ya kuzaliwa. Muda sahihi unahakikisha mahesabu sahihi ya nyumba."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "துல்லியமான பிறப்பு விவரங்களை உள்ளிடவும். துல்லியமான நேரம் சரியான வீட்டு கணக்கீடுகளை உறுதி செய்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖచ్చితమైన జన్మ వివరాలను నమోదు చేయండి. ఖచ్చితమైన సమయం సరైన గృహ లెక్కలను నిర్ధారిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกรายละเอียดการเกิดที่แน่นอน เวลาที่แม่นยำช่วยให้คำนวณเรือนได้ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En iyi sonuçlar için doğum saatini tam olarak girin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть точні дані народження для розрахунку натальної карти. Час має бути максимально точним для коректного визначення будинків."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست پیدائشی تفصیلات درج کریں۔ درست وقت درست گھر کی گنتی کو یقینی بناتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập thông tin sinh chính xác. Giờ chính xác đảm bảo tính toán cung đúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入准确的出生信息。精确的时间可确保准确计算宫位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入準確的出生資訊。精確的時間可確保準確計算宮位。"
          }
        }
      }
    },
