        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "5 imagens serão compartilhadas. Crie um carrossel no Instagram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "5 imagini vor fi distribuite. Creează o postare carousel pe Instagram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет опубликовано 5 изображений. Создайте карусель в Instagram."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "5 obrázkov bude zdieľaných. Vytvorte kolotočový príspevok na Instagrame."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 slik bo deljenih. Ustvari vrtiljak objavo na Instagramu."
