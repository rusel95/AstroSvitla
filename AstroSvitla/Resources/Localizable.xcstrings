    "share.carousel.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مشاركة 5 صور."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще бъдат споделени 5 изображения. Създай карусел публикация в Instagram."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৫টি ছবি শেয়ার করা হবে। Instagram এ একটি ক্যারাউসেল পোস্ট তৈরি করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude sdíleno 5 obrázků. Vytvořte karusel příspěvek na Instagramu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "5 billeder deles. Opret et karruselindlæg på Instagram."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Bilder werden geteilt. Erstelle einen Karussell-Beitrag in Instagram."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα κοινοποιηθούν 5 εικόνες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 images will be shared. Create a carousel post in Instagram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se compartirán 5 imágenes. Crea un carrusel en Instagram."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "5 pilti jagatakse. Loo karussellpostitus Instagramis."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۵ تصویر به اشتراک گذاشته خواهد شد. یک پست کاروسل در اینستاگرام ایجاد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 kuvaa jaetaan. Luo karusellipostaus Instagramissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "5 larawan ang ibabahagi. Gumawa ng carousel post sa Instagram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 images seront partagées. Créez un carrousel sur Instagram."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "5 છબીઓ શેર થશે. Instagram પર કેરોસેલ પોસ્ટ બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "5 תמונות ישותפו. צור פוסט קרוסלה באינסטגרם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 छवियां साझा की जाएंगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 slika će biti podijeljeno. Izradi vrtuljak objavu na Instagramu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "5 kép lesz megosztva. Hozz létre carousel posztot az Instagramon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "5 gambar akan dibagikan. Buat postingan carousel di Instagram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno condivise 5 immagini. Crea un carosello su Instagram."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5枚の画像が共有されます。Instagramでカルーセル投稿を作成してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ಚಿತ್ರಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಲಾಗುತ್ತದೆ. Instagram ನಲ್ಲಿ ಕ್ಯಾರೋಸೆಲ್ ಪೋಸ್ಟ್ ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5개의 이미지가 공유됩니다. Instagram에서 캐러셀 게시물을 만드세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus pasidalinta 5 nuotraukomis. Sukurkite karuselės įrašą Instagram."
