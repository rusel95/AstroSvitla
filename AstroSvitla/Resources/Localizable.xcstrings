        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 प्रतिमा शेअर केल्या जातील. Instagram वर कॅरोसेल पोस्ट तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "5 gambar akan dikongsi. Cipta siaran karusel di Instagram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "5 bilder vil bli delt. Opprett et karusellinnlegg på Instagram."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "5 afbeeldingen worden gedeeld."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ਤਸਵੀਰਾਂ ਸਾਂਝੀਆਂ ਹੋਣਗੀਆਂ। Instagram 'ਤੇ ਕੈਰੋਸਲ ਪੋਸਟ ਬਣਾਓ।"
